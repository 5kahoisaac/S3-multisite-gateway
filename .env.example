# The suffix used to select an S3 prefix from a single-level subdomain.
BASE_DOMAIN=example.com

# S3-compatible object storage (AWS S3, MinIO, Cloudflare R2, etc.)
S3_BUCKET=static
AWS_REGION=us-east-1

# For AWS S3, leave S3_ENDPOINT empty and set S3_FORCE_PATH_STYLE=false.
# For MinIO or another S3-compatible service, specify its endpoint URL.
S3_ENDPOINT=https://s3.example-storage.com
S3_FORCE_PATH_STYLE=true

# Runtime credentials: never COPY .env into the Docker image or commit it.
# You may omit these when running with an IAM role / other AWS credential source.
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
# AWS_SESSION_TOKEN=...

# Frontend HTTP port on your Docker host.
HTTP_PORT=8080

# Optional. true serves project/index.html for missing extensionless SPA routes.
SPA_FALLBACK=false

# In-memory S3 response cache
# Set CACHE_TTL=0s to disable
CACHE_TTL=6h
CACHE_MAX_MB=128
CACHE_MAX_OBJECT_MB=8

# Fallback HTTP cache header, used if S3 doesn't specify Cache-Control
DEFAULT_CACHE_CONTROL=public, max-age=300
